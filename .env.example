# Токен бота от @BotFather
TG_BOT_TOKEN=

# Твой Telegram user id. Можно оставить пустым — тогда владельцем станет
# первый, кто напишет боту /start.
OWNER_TG_ID=

# Номер аккаунта MAX, от имени которого пишем
MAX_PHONE=

# Файл сессии MAX (лежит в data/)
MAX_SESSION=max.db

# Локальный Bot API (необязательно). Если задан — бот ходит в Telegram не на
# api.telegram.org, а на этот адрес (например, контейнер telegram-bot-api --local).
# Тогда TG-трафик тянет демон, а самому боту VPN не нужен: MAX пойдёт напрямую.
TG_API_BASE=

# --- настройки моста (то же самое есть кнопками в /settings) --------------
# Значение из .env работает, пока в боте галочку не трогали. Формат: 1/0.
# BRIDGE_GET_CHANNELS=0      # пересылать сообщения из каналов MAX
# BRIDGE_GET_SERVICE=0       # служебные аккаунты (Безопасность, Коды подтверждения)
# BRIDGE_GET_CALLS=1         # чаты «Групповой звонок <дата>»
# BRIDGE_GET_SAVED=1         # Избранное (чат с самим собой, id 0)
# BRIDGE_NOTIFY_READ=1       # статусы прочтения
# BRIDGE_NOTIFY_EDIT=1       # уведомления о правках
# BRIDGE_NOTIFY_DELETE=1     # уведомления об удалениях
# BRIDGE_NOTIFY_REACTIONS=1  # уведомления о реакциях
# BRIDGE_NOTIFY_TYPING=1     # показывать «печатает…»
# BRIDGE_FORWARD_VOICE=1     # пересылать голосовые и кружки файлом
# BRIDGE_AUTO_READ=0         # читаешь в TG — отмечается прочитанным в MAX
# BRIDGE_QUIET_HOURS=0       # тихие часы
# BRIDGE_QUIET_FROM=23       # тихие часы: с какого часа
# BRIDGE_QUIET_TO=8          # тихие часы: до какого часа
# BRIDGE_LIMIT_TO_MAX=20     # лимит отправки в MAX, МБ
# BRIDGE_LIMIT_TO_TG=48      # лимит приёма из MAX, МБ

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO
